# ============================================================
# Hybrid Document-Graph Store - Git Ignore
# ============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Data files (generated at runtime)
# data/raw/
# data/processed/
# *.json

# Whoosh search index
whoosh_index/

# METIS auxiliary files
*.adj*
*.graph*
*.i.*
*.o.*
*.p.*
metis_output/

# Jupyter notebooks
.ipynb_checkpoints/
notebooks/*.ipynb_checkpoints

# Test coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/

# Environment variables
.env
.env.local
.env.*.local

# Flask
instance/
.webassets-cache

# Node modules (if any)
node_modules/

# Build artifacts
*.pyc
*.pyo
*.db
*.sqlite

# Processed graph export (regenerated)
graph_export.json
